# Gemini AI, server-side only. Do not prefix this with VITE_.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
VITE_EDGE_AI_ENABLED=1
VITE_EDGE_AI_ENDPOINT=/api/folio-answer
VITE_EDGE_AI_MODEL=gemini-2.5-flash

# ElevenLabs TTS — optional, agent voice responses
# Get a key at https://elevenlabs.io
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key
VITE_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# NDA reviewer gate, client-side only.
# Prefer the SHA-256 hash so the raw reviewer code is not written into the bundle.
# Generate a hash with:
# node -e "console.log(require('crypto').createHash('sha256').update('your-reviewer-code').digest('hex'))"
VITE_NDA_ACCESS_SHA256=

# Optional local fallback. Do not use this in production because VITE_* values are public.
VITE_NDA_ACCESS_CODE=

# Supabase comments, client-side public key only.
# Use the project URL and publishable key from Project Settings > API Keys.
# The legacy anon key also works while Supabase still supports it.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback for older Supabase projects only:
VITE_SUPABASE_ANON_KEY=
VITE_COMMENTS_TABLE=portfolio_comments
